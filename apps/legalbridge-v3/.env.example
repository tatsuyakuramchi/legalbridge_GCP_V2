# LegalBridge V3。V2 とは別サービスとして動かす想定（同一 Cloud SQL・v3 スキーマ）。
PORT=8081

# 接続。DATABASE_URL か、個別指定のどちらか。
# DATABASE_URL=postgres://legalbridge_v3_runtime:...@localhost:5432/legalbridge
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legalbridge
DB_USER=legalbridge_v3_runtime
DB_PASSWORD=
# 触るスキーマ。public（V1・V2 の表）には接続時点で近づかない。
DB_SCHEMA=v3
# 参照専用で立てるとき。書込APIは 503 を返す。
READ_ONLY=false

# 認証。iap は x-goog-authenticated-user-email を前段で検証している前提。
AUTH_MODE=disabled
ADMIN_EMAILS=
LEGAL_EMAILS=
REQUESTER_DOMAINS=

# PDF 生成。Cloud Run のイメージに入れた Chromium を指す。
CHROMIUM_PATH=/usr/bin/chromium-browser
# ローカル検証で Chromium を使わないとき。
# PDF_RENDERER=memory

# Drive 保存。未設定なら保存機能だけが無効になり、文書の作成と発行は動く。
GOOGLE_DRIVE_FOLDER_ID=
# 専用 Workspace SA の鍵（Secret Manager からマウント）。無ければ ADC へ落ちる。
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
DRIVE_ENVIRONMENT_TAG=validation
# 案件フォルダを作る親フォルダ。未設定なら案件フォルダ機能だけが無効。
DRIVE_MATTER_PARENT_FOLDER_ID=
# ローカル検証で Drive を叩かないとき。
# DRIVE_STORAGE=memory
