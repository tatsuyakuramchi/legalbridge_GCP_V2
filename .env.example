NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://legalbridge:legalbridge@localhost:5432/legalbridge_v2
DB_ACCESS_MODE=readonly
REQUIRE_DATABASE=false
WRITE_FEATURES_ENABLED=false
WRITE_SCOPES=
APP_BASE_URL=http://localhost:5173

# local: 外部送信せず、処理内容をログへ記録
# live: GCP Secret Manager経由の認証情報を利用
INTEGRATION_MODE=local

# 本番では既存値をSecret Managerから設定する
BACKLOG_API_KEY=
BACKLOG_SPACE_URL=
GOOGLE_DRIVE_FOLDER_ID=
SLACK_WEBHOOK_URL=
CLOUDSIGN_CLIENT_ID=
GMAIL_SENDER=
