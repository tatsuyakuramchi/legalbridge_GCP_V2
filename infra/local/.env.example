# infra/local/.env に写して埋める。.env は git に入らない。

# --- ローカル DB ---------------------------------------------------------
# ローカル PostgreSQL の管理者（postgres）のパスワード。
LOCAL_DB_PASSWORD=
# アプリが使うランタイムロール legalbridge_v3_runtime のパスワード（ローカル用に新しく決める）。
V3_RUNTIME_PASSWORD=

# --- 本番からの同期（予備系として使うときだけ） ---------------------------
CLOUD_SQL_INSTANCE=legalbridge-488506:asia-northeast1:legalbridge-db
REMOTE_DB_NAME=legalbridge
# sql/backup_role.sql で作る読み取り専用ロールとそのパスワード。
SYNC_DB_USER=legalbridge_v3_backup
SYNC_DB_PASSWORD=
# 手元に残す写しの世代数（古いものから消す）。
KEEP_DUMPS=14
# 社内ネットワークが 3307 番を塞いでいて、Proxy を PC 側で動かす場合だけ設定する。
# 詳しくは README の「Proxy を PC 側で動かす」。
#SYNC_DB_HOST=host.docker.internal
#SYNC_DB_PORT=5433

# --- アプリ ---------------------------------------------------------------
APP_PORT=8080
# 予備系は true。開発で書き込みを試すときだけ false。
READ_ONLY=true
# 認証なしで名乗る利用者。役割は admin / legal / requester。
LOCAL_USER_EMAIL=backup@local
LOCAL_USER_ROLE=admin
# 画面の隅に出す環境名。
SITE_LABEL=予備系
